# Mocks are opt-in. Leave NEXT_PUBLIC_USE_MOCKS unset (or "false") for any build that should talk
# to Firebase — a missing variable must never silently serve in-memory data. Set it to "true" only
# for local UI work without a backend; production builds drop the mock adapter entirely.
# NEXT_PUBLIC_USE_MOCKS=true

NEXT_PUBLIC_API_BASE_URL=https://europe-west4-biohabit.cloudfunctions.net/api
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=biohabit.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=biohabit
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=biohabit.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=162707730020
NEXT_PUBLIC_FIREBASE_APP_ID=1:162707730020:web:bf22dd5bc2779d7ac5b971
