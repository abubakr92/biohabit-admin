# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.next-dev.*.log
functions/lib/
.tools/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files are private; commit only the documented template
.env*
!.env.example
# functions/.env is non-secret deploy config (CORS origins). It must be committed: deploying
# without it leaves the API rejecting every browser origin. Secrets belong in Secret Manager.
!functions/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Operational backups written by the one-off data fix scripts in functions/src/scripts.
functions/*-backup-*.json
